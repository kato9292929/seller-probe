# ---- Probe 専用ウォレット（Autonomous Agent の鍵・ウォレットは使わない） ----
# Solana: base58 の 64 バイト秘密鍵、または solana-keygen の JSON 配列
PROBE_SOLANA_SECRET_KEY=
# Base: 0x で始まる 32 バイト秘密鍵
PROBE_EVM_PRIVATE_KEY=

# ---- RPC（本番） ----
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BASE_RPC_URL=https://mainnet.base.org

# ---- 対象 ----
# カタログ（endpoint リポジトリの公開スナップショット）。ローカルの .json / .json.gz を使う場合だけ指定
# CATALOG_FILE=../endpoint/data/endpoints_full.json.gz
# 自社エンドポイント（§3.3 の試験はこの 2 つにだけ当てる）
JIN_PAID_URL=https://jin.x402jp.com/api/jin/series
OSD_PAID_URL=https://osd.x402jp.com/api/alpha/portfolio/current

# ---- RFQ（参考値として公開ページに並べる。スコアには入れない） ----
RFQ_INDEXER_URL=

# Node の fetch がプロキシを使う場合だけ
# NODE_USE_ENV_PROXY=1
